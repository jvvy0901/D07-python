# 이 파일을 .env 로 복사한 뒤 값을 채워 주세요 (cp .env.example .env)
# .env 는 .gitignore 에 들어 있어 깃에 올라가지 않아요

# weather.py (streamlit run weather.py) 에서 사용 - https://openweathermap.org/api
OPENWEATHER_API_KEY=

# rateCalc.py (streamlit run rateCalc.py) 에서 사용 - https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=

# chat.py (streamlit run chat.py) 에서 사용 - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 아래 키는 아직 쓰는 파일이 없어요
KAKAO_REST_API_KEY=
